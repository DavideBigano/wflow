{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "run": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for the run."
                },
                "name": {
                    "type": "string",
                    "maxLength": 30,
                    "description": "Display name for the run. ~3-5 words max"
                },
                "description": {
                    "type": "string",
                    "maxLength": 60,
                    "description": "Short description about the run. ~10 words max."
                }
            },
            "required": ["id", "name", "description"]
        }
    },
    "required": ["run"]
}
